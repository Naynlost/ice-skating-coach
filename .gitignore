# Sporcu videolari ve ara ciktilar git'e girmez.
# Dizin yapisi korunur, icerik girmez: `data/` tek basina yazilsaydi git alt
# dizinlere hic bakmaz ve .gitkeep dosyalari da disarida kalirdi.
data/**
!data/**/
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Arac onbellekleri
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model agirliklari (yolo11m.pt ~39 MB, ilk calistirmada kendisi iner)
*.pt
*.onnx

# Ortam
.env
.env.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
